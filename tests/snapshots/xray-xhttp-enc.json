{
  "listen": "127.0.0.1",
  "port": 8443,
  "protocol": "vless",
  "settings": {
    "clients": [
      {
        "flow": "",
        "id": "11111111-1111-4111-8111-111111111111"
      }
    ],
    "decryption": "mlkem768x25519plus.native.600s.-Ml20GaEPBtF8DcrC2-UN1uhUTooSNoaXiS90RvsrlA"
  },
  "sniffing": {
    "destOverride": [
      "http",
      "tls",
      "quic"
    ],
    "enabled": true
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "tls",
    "tlsSettings": {
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "certificates": [
        {
          "certificateFile": "/etc/nginx/ssl/a.example.com/fullchain.pem",
          "keyFile": "/etc/nginx/ssl/a.example.com/privkey.pem"
        }
      ],
      "serverName": "a.example.com"
    },
    "xhttpSettings": {
      "mode": "auto",
      "path": "/p"
    }
  },
  "tag": "xhttp-enc"
}
